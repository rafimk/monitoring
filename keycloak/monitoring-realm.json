{
  "realm": "monitoring",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "monitoring-viewer", "description": "Read-only access to the job monitoring dashboard" },
      { "name": "monitoring-operator", "description": "Viewer + run now, enable and disable jobs" },
      { "name": "monitoring-administrator", "description": "Operator + edit job settings, read the audit log" }
    ]
  },
  "clients": [
    {
      "clientId": "monitoring-web",
      "name": "Job Monitoring dashboard (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [ "http://localhost:5173/*" ],
      "webOrigins": [ "http://localhost:5173" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "monitoring-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "monitoring-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "monitoring-dev-cli",
      "name": "LOCAL TESTING ONLY: password grant for scripts. Delete in any shared realm.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "monitoring-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "monitoring-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    { "username": "viewer", "enabled": true, "email": "viewer@example.test", "emailVerified": true, "firstName": "Vera", "lastName": "Viewer",
      "credentials": [ { "type": "password", "value": "Dev_Passw0rd!", "temporary": false } ], "realmRoles": [ "monitoring-viewer" ] },
    { "username": "operator", "enabled": true, "email": "operator@example.test", "emailVerified": true, "firstName": "Omar", "lastName": "Operator",
      "credentials": [ { "type": "password", "value": "Dev_Passw0rd!", "temporary": false } ], "realmRoles": [ "monitoring-operator" ] },
    { "username": "admin", "enabled": true, "email": "admin@example.test", "emailVerified": true, "firstName": "Ada", "lastName": "Admin",
      "credentials": [ { "type": "password", "value": "Dev_Passw0rd!", "temporary": false } ], "realmRoles": [ "monitoring-administrator" ] },
    { "username": "norole", "enabled": true, "email": "norole@example.test", "emailVerified": true, "firstName": "Nora", "lastName": "NoRole",
      "credentials": [ { "type": "password", "value": "Dev_Passw0rd!", "temporary": false } ], "realmRoles": [] }
  ]
}
