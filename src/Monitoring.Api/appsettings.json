{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Monitoring": "" },
  "Keycloak": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "RoleSource": "Realm",
    "ClientId": "",
    "ViewerRole": "monitoring-viewer",
    "OperatorRole": "monitoring-operator",
    "AdministratorRole": "monitoring-administrator"
  },
  "Api": {
    "JwtKey": "",
    "JwtIssuer": "monitoring",
    "JwtAudience": "monitoring-web",
    "AllowedOrigins": [],
    "WorkerStaleSeconds": 45,
    "EnableDevTokens": false,
    "ChangeFeedEnabled": true,
    "ChangeFeedPollMilliseconds": 1000
  }
}
