# --- Monitoring.Api ---
# Base URL of Monitoring.Api (no trailing slash). The SignalR hub is {API}/hubs/monitoring.
VITE_API_BASE_URL=http://localhost:5284

# --- Keycloak (public SPA client, Authorization Code + PKCE; there is NO client secret) ---
# Keycloak base URL without /realms/...  (Keycloak 17+ default has no /auth prefix)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=monitoring
VITE_KEYCLOAK_CLIENT_ID=monitoring-web

# Where the monitoring roles live in the token (must match the API's Keycloak:RoleSource):
#   realm  -> realm_access.roles (default)      client -> resource_access.<client>.roles
VITE_KEYCLOAK_ROLE_SOURCE=realm
# VITE_KEYCLOAK_ROLE_CLIENT_ID=monitoring-web     (only when ROLE_SOURCE=client)
# Keycloak role names that mean viewer / operator / administrator (defaults shown). Presentation only: the API decides.
# VITE_ROLE_VIEWER=monitoring-viewer
# VITE_ROLE_OPERATOR=monitoring-operator
# VITE_ROLE_ADMINISTRATOR=monitoring-administrator

# --- Development only ---
# Shows the "sign in as role" form (uses the API's Development-only /api/v1/auth/dev-token). It is compiled out of
# `npm run build`, whatever this is set to.
VITE_DEV_LOGIN=false
