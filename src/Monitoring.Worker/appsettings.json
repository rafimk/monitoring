{
  "ConnectionStrings": {
    "Monitoring": ""
  },
  "Worker": {
    "ApplicationName": "monitoring-local",
    "PollIntervalSeconds": 2,
    "LeaseSeconds": 60,
    "HeartbeatSeconds": 15,
    "MaxParallelism": 4,
    "SchedulerBatchSize": 50,
    "ShutdownGraceSeconds": 30,
    "LeaderMode": "ActiveStandby",
    "LeaderLockResource": "monitoring-worker-leader",
    "StandbyRetrySeconds": 5,
    "LeaderCheckSeconds": 5,
    "Retention": {
      "Enabled": true,
      "JobHistoryRetentionDays": 30,
      "AuditRetentionDays": 365,
      "ChangeFeedRetentionDays": 7,
      "BatchSize": 1000,
      "BatchPauseMilliseconds": 50,
      "RunAt": "02:00",
      "TimeZoneId": "UTC"
    },
    "ApplyMigrationsOnStartup": false,
    "SeedSampleData": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  }
}
